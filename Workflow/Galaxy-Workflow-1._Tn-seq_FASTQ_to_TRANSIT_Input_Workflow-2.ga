            "tool_state": "{\"add_to_database\": {\"withdb\": {\"__class__\": \"RuntimeValue\"}}, \"addqueries\": {\"queries\": []}, \"modify_database\": {\"sql_stmts\": []}, \"query_result\": {\"header\": \"yes\", \"__current_case__\": 0, \"header_prefix\": \"35\"}, \"save_db\": false, \"sqlquery\": \"SELECT\\n    TA.start AS TA_start,\\n    TA.end AS TA_end,\\n    TA.seqID AS seqID,\\n    COALESCE(\\n        GROUP_CONCAT(\\n            CASE\\n                WHEN GENE.c9 IS NOT NULL\\n                THEN\\n                    CASE\\n                        WHEN instr(\\n                            substr(GENE.c9, instr(GENE.c9, 'locus_tag=') + 10),\\n                            ';'\\n                        ) > 0\\n                        THEN substr(\\n                            substr(GENE.c9, instr(GENE.c9, 'locus_tag=') + 10),\\n                            1,\\n                            instr(\\n                                substr(GENE.c9, instr(GENE.c9, 'locus_tag=') + 10),\\n                                ';'\\n                            ) - 1\\n                        )\\n                        ELSE substr(\\n                            GENE.c9,\\n                            instr(GENE.c9, 'locus_tag=') + 10\\n                        )\\n                    END\\n            END,\\n            '|'\\n        ),\\n        'intergenic'\\n    ) AS locus_tag\\nFROM TA\\nLEFT JOIN GENE\\n    ON TA.seqID = GENE.c1\\n    AND CAST(TA.start AS INTEGER)\\n        BETWEEN CAST(GENE.c4 AS INTEGER) AND CAST(GENE.c5 AS INTEGER)\\nGROUP BY\\n    TA.seqID,\\n    TA.start,\\n    TA.end\\nORDER BY\\n    CAST(TA.start AS INTEGER)\", \"tables\": [{\"__index__\": 0, \"table\": {\"__class__\": \"ConnectedValue\"}, \"input_opts\": {\"linefilters\": []}, \"tbl_opts\": {\"table_name\": \"TA\", \"column_names_from_first_line\": true, \"col_names\": \"\", \"load_named_columns\": false, \"pkey_autoincr\": \"\", \"indexes\": []}}, {\"__index__\": 1, \"table\": {\"__class__\": \"ConnectedValue\"}, \"input_opts\": {\"linefilters\": []}, \"tbl_opts\": {\"table_name\": \"GENE\", \"column_names_from_first_line\": false, \"col_names\": \"\", \"load_named_columns\": false, \"pkey_autoincr\": \"\", \"indexes\": []}}], \"workdb\": \"workdb.sqlite\", \"__page__\": 0, \"__rerun_remap_job_id__\": null}",
